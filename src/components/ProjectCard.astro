---
import TagList from "./TagList.astro";
const { project } = Astro.props;
const { slug, data } = project;
const hasMedia = data.hero_image?.startsWith("/images/resume/") || data.hero_image?.endsWith(".jpeg");
---
<article
  class="card project-card reveal"
  data-project-card
  data-category={data.category}
  data-tags={data.tags.join(",")}
>
  <a href={`/projects/${slug}`} class="project-link">
    <div class="project-image">
      {hasMedia ? (
        <img src={data.hero_image} alt={data.title} loading="lazy" />
      ) : (
        <div class="blank-media" aria-hidden="true"></div>
      )}
    </div>
    <div class="project-content">
      <p class="eyebrow">{data.category}</p>
      <h3 class="project-title">{data.title}</h3>
      <p class="subtle">{data.summary}</p>
      <TagList tags={data.tags} />
      {slug === "agridefend" && (
        <span class="badge patent-pending" aria-label="Patent Pending">Patent Pending</span>
      )}
    </div>
  </a>
  {data.links && data.links.length > 0 && (
    <div class="project-links">
      {data.links.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer" class="text-link">{link.label}</a>
      ))}
    </div>
  )}
</article>
