---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import { getEntry } from "astro:content";

const profile = await getEntry("profile", "site");
---
<BaseLayout>
  <!-- ── HERO ── -->
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow fade-up">IB Diploma Candidate · Class of 2027</p>
        <h1 class="display hero-title fade-up">{profile?.data.full_name}</h1>
        <p class="hero-subtitle fade-up-delay">
          Building applied AI systems across healthcare, food security, and civic tech.
        </p>
        <div class="hero-actions fade-up-delay">
          <a class="button" href="/projects">View Projects</a>
          <a class="button ghost" href="/contact">Contact</a>
        </div>
        <div class="hero-meta fade-up-delay-2">
          <div class="meta-item">
            <p class="meta-label">Focus</p>
            <p class="meta-value">{profile?.data.intended_major}</p>
          </div>
          <div class="meta-item">
            <p class="meta-label">Builds</p>
            <p class="meta-value">Edge AI · Health ML · Civic Tools</p>
          </div>
          <div class="meta-item">
            <p class="meta-label">Now</p>
            <p class="meta-value">Shipping prototypes</p>
          </div>
        </div>
      </div>
      <div class="hero-card hero-orbit fade-up-delay">
        <div class="orbit-ring"></div>
        <div class="orbit-node orbit-node-1"></div>
        <div class="orbit-node orbit-node-2"></div>
        <div class="orbit-node orbit-node-3"></div>
        <div class="hero-card-body">
          <p class="eyebrow">Project Engine</p>
          <h2 class="display">Prototype, test, refine.</h2>
          <p class="subtle">A portfolio centered on systems that move from idea to working demo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-accent section-intro">
    <div class="container">
      <SectionTitle
        eyebrow="Studio Board"
        title="What I’m actually doing"
        description="A quick read on the kind of work I like to ship, without turning the homepage into another project dump."
      />
      <div class="studio-board">
        <aside class="studio-rail reveal">
          <div class="studio-panel">
            <p class="eyebrow">Current Mode</p>
            <h3>Building systems that feel immediate and useful.</h3>
            <p class="subtle">
              I care most about work that can move from concept to something a real person can touch, test, and trust.
            </p>
          </div>
          <div class="studio-panel">
            <div class="studio-metric">
              <span class="subtle">Focus</span>
              <strong>Edge AI</strong>
            </div>
            <div class="studio-metric">
              <span class="subtle">Format</span>
              <strong>Prototypes + field tests</strong>
            </div>
            <div class="studio-metric">
              <span class="subtle">Style</span>
              <strong>Clean, fast, usable</strong>
            </div>
          </div>
        </aside>
        <div class="studio-tiles">
          <article class="studio-tile reveal reveal-delay-1">
            <p class="eyebrow">1</p>
            <h3>Make the first screen obvious.</h3>
            <p class="subtle">
              The homepage now opens with a clear signal instead of a recycled list of cards.
            </p>
          </article>
          <article class="studio-tile reveal reveal-delay-2">
            <p class="eyebrow">2</p>
            <h3>Keep the work visible, not noisy.</h3>
            <p class="subtle">
              Projects still live on the projects page, but the home page stays editorial and focused.
            </p>
          </article>
          <article class="studio-tile reveal reveal-delay-3">
            <p class="eyebrow">3</p>
            <h3>Use motion with a point.</h3>
            <p class="subtle">
              Subtle scroll reveals and sticky positioning give the page shape without making it busy.
            </p>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
