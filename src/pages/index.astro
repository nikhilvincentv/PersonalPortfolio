---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection, getEntry } from "astro:content";

const profile = await getEntry("profile", "site");
const projects = await getCollection("projects");

const featuredProjects = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

const scrollProjects = featuredProjects.map((project) => ({
  title: project.data.title,
  category: project.data.category,
  summary: project.data.summary,
  image: project.data.hero_image,
  slug: project.slug
}));
const isRealMedia = (path) =>
  path.startsWith("/images/resume/") ||
  path.endsWith(".png") ||
  path.endsWith(".jpeg");
---
<BaseLayout>
  <!-- ── HERO ── -->
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow fade-up">IB Diploma Candidate · Class of 2027</p>
        <h1 class="display hero-title fade-up">{profile?.data.full_name}</h1>
        <p class="hero-subtitle fade-up-delay">
          Building applied AI systems across healthcare, food security, and civic tech.
        </p>
        <div class="hero-actions fade-up-delay">
          <a class="button" href="/projects">View Projects</a>
          <a class="button ghost" href="/contact">Contact</a>
        </div>
        <div class="hero-meta fade-up-delay-2">
          <div class="meta-item">
            <p class="meta-label">Focus</p>
            <p class="meta-value">{profile?.data.intended_major}</p>
          </div>
          <div class="meta-item">
            <p class="meta-label">Builds</p>
            <p class="meta-value">Edge AI · Health ML · Civic Tools</p>
          </div>
          <div class="meta-item">
            <p class="meta-label">Now</p>
            <p class="meta-value">Shipping prototypes</p>
          </div>
        </div>
      </div>
      <div class="hero-card hero-orbit fade-up-delay">
        <div class="orbit-ring"></div>
        <div class="orbit-node orbit-node-1"></div>
        <div class="orbit-node orbit-node-2"></div>
        <div class="orbit-node orbit-node-3"></div>
        <div class="hero-card-body">
          <p class="eyebrow">Project Engine</p>
          <h2 class="display">Prototype, test, refine.</h2>
          <p class="subtle">A portfolio centered on systems that move from idea to working demo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="scroll-story" data-scroll-story>
    <div class="container scroll-story-inner">
      <div class="scroll-copy">
        <p class="eyebrow">Scroll Reel</p>
        <h2 class="display section-title">Three builds, one throughline</h2>
        <p class="subtle section-description">
          Each project moves from sensing or input, through an ML or product layer, into something someone can actually use.
        </p>
      </div>
      <div class="scroll-stage">
        {scrollProjects.map((project, i) => (
          <a
            class={`scroll-panel ${i === 0 ? "active" : ""}`}
            href={`/projects/${project.slug}`}
            data-scroll-panel
          >
            <div class="scroll-panel-media">
              {isRealMedia(project.image) ? (
                <img src={project.image} alt={project.title} loading={i === 0 ? "eager" : "lazy"} />
              ) : (
                <div class="blank-media" aria-hidden="true"></div>
              )}
            </div>
            <div>
              <p class="eyebrow">{project.category}</p>
              <h3>{project.title}</h3>
              <p class="subtle">{project.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="scroll-progress" aria-hidden="true">
        {scrollProjects.map((_, i) => <span class={i === 0 ? "active" : ""} data-scroll-dot></span>)}
      </div>
    </div>
  </section>

  <!-- ── FEATURED PROJECTS ── -->
  <section class="section section-accent">
    <div class="container">
      <SectionTitle
        eyebrow="Projects"
        title="Built work, no filler"
        description="Applied systems across edge AI, healthcare ML, and civic tech."
      />
      <div class="grid grid-3">
        {featuredProjects.map((project, i) => (
          <div class={`reveal reveal-delay-${i + 1}`}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const story = document.querySelector("[data-scroll-story]");
    const panels = [...document.querySelectorAll("[data-scroll-panel]")];
    const dots = [...document.querySelectorAll("[data-scroll-dot]")];

    if (story && panels.length) {
      const setActivePanel = () => {
        const rect = story.getBoundingClientRect();
        const progress = Math.min(0.999, Math.max(0, -rect.top / (rect.height - window.innerHeight)));
        const activeIndex = Math.min(panels.length - 1, Math.floor(progress * panels.length));

        panels.forEach((panel, index) => {
          panel.classList.toggle("active", index === activeIndex);
          panel.style.setProperty("--panel-shift", `${(index - activeIndex) * 18}px`);
        });
        dots.forEach((dot, index) => dot.classList.toggle("active", index === activeIndex));
      };

      window.addEventListener("scroll", () => requestAnimationFrame(setActivePanel), { passive: true });
      window.addEventListener("resize", setActivePanel);
      setActivePanel();
    }
  </script>
</BaseLayout>
